{
  "name": "cashless-snail",
  "private": true,
  "description": "Plataforma cashless multi-entitat per a esdeveniments",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:shared": "pnpm --filter @cashless/shared build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @cashless/api test",
    "dev:api": "pnpm --filter @cashless/api dev",
    "dev:backoffice": "pnpm --filter @cashless/backoffice dev",
    "dev:tpv": "pnpm --filter @cashless/tpv start",
    "db:migrate": "pnpm --filter @cashless/api db:migrate",
    "db:seed": "pnpm --filter @cashless/api db:seed"
  }
}
