# Connexió a PostgreSQL
DATABASE_URL=postgres://cashless:cashless@localhost:5432/cashless

# Clau per signar les sessions. Genera'n una de llarga i aleatòria per a producció:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=canvia-aquesta-clau-per-una-de-llarga-i-aleatoria

PORT=3000

# Orígens permesos per al backoffice (separats per comes)
CORS_ORIGINS=http://localhost:5173

# URL pública de l'API (s'inclou al QR de vinculació dels terminals)
PUBLIC_API_URL=http://localhost:3000

# Primer administrador de plataforma (només el fa servir el seed)
SEED_ADMIN_EMAIL=admin@cashless.local
SEED_ADMIN_PASSWORD=canvia-aquesta-contrasenya
