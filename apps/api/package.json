{
  "name": "@cashless/api",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor central: lògica de negoci, permisos i llibre de moviments",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node -r ts-node/register src/db/migrate.ts",
    "db:seed": "node -r ts-node/register src/db/seed.ts",
    "test": "jest --runInBand",
    "build:edge": "node scripts/build-edge.mjs"
  },
  "dependencies": {
    "@cashless/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.13.14",
    "postgres": "^3.4.9",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "esbuild": "^0.28.0"
  },
  "jest": {
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
