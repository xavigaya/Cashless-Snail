{
  "expo": {
    "name": "Cashless Snail",
    "slug": "cashless-tpv",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "cat.cashlesssnail.tpv",
      "supportsTablet": true,
      "infoPlist": {
        "NFCReaderUsageDescription": "Per llegir les polseres de pagament"
      }
    },
    "android": {
      "package": "cat.cashlesssnail.tpv",
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C8F03C"
      }
    },
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Per llegir les polseres de pagament",
          "includeNdefEntitlement": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Per escanejar el QR de les polseres i de vinculació del terminal",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "backgroundColor": "#0B1F19"
  }
}
